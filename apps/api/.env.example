# Local databases (via docker-compose)
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
ES_URL=http://elasticsearch:9200
ES_USER=elastic
ES_PASS=

# AI services
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=5

# Merged RF-DETR object detections used for post-filtering Milvus results.
OBJECT_DETECTIONS_PATH=../../data/objects/object_detections.parquet
VIDEOS_DIR=../../data/video

# DRES (Distributed Retrieval Evaluation Server)
# Username/password are entered at runtime via the DRES Settings dialog, not env vars.
DRES_URL=http://34.27.44.11:8080

# MinIO/S3 storage for keyframes + videos (path-style URLs: http(s)://ENDPOINT/bucket/key).
# Practice: public domain over https.
#   MINIO_ENDPOINT=s3.sunnydev.qzz.io
#   MINIO_SECURE=true
# Competition day: swap to the Tailscale IP so nothing depends on public internet.
#   MINIO_ENDPOINT=100.x.x.x:9000
#   MINIO_SECURE=false
MINIO_ENDPOINT=s3.sunnydev.qzz.io
MINIO_SECURE=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_KEYFRAMES=keyframes
MINIO_BUCKET_VIDEOS=videos
