# Local API connecting to databases exposed by docker-compose
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASS=

# AI services
OPENAI_API_KEY=your_openai_key
ENSEMBLE_CONFIG_PATH=config/ensemble.json
ENSEMBLE_RRF_K=60
ENSEMBLE_CANDIDATE_TOP_K=200
TEXT_EMBEDDING_CACHE_SIZE=512
KEYFRAMES_DIR=../../data/keyframes/keyframes
GUNICORN_WORKERS=1

# DRES v2 submission (provided by the competition organizer)
DRES_BASE_URL=
DRES_EVALUATION_ID=
# Optional alternative to logging in from the UI
DRES_SESSION_TOKEN=
DRES_TIMEOUT_SECONDS=10

# Model caches (recommended: mount these paths on GPU inference machines)
HF_HOME=../../.cache/huggingface
TORCH_HOME=../../.cache/torch

# Flask
SECRET_KEY=your_secret_key
FLASK_ENV=development
