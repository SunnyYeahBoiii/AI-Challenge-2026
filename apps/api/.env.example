# Local databases (via docker-compose)
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
ES_URL=http://elasticsearch:9200
ES_USER=elastic
ES_PASS=

# AI services
OPENAI_API_KEY=your_openai_key

# CLIP checkpoint. Must match the one that produced the .npy embeddings loaded
# into Milvus; a different checkpoint degrades search silently.
CLIP_MODEL_ID=hf-hub:apple/DFN5B-CLIP-ViT-H-14-384

# Merged RF-DETR object detections used for post-filtering Milvus results.
OBJECT_DETECTIONS_PATH=../../data/objects/object_detections.parquet

# Flask
SECRET_KEY=your_secret_key
FLASK_ENV=development

# DRES (Distributed Retrieval Evaluation Server) - USER participant
DRES_URL=http://34.27.44.11:8080
DRES_USERNAME=ghienaram
